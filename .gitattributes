# =============================================================================
# GITATTRIBUTES - LÍNEAS FINALES CORRECTAS PARA CADA PLATAFORMA
# =============================================================================
# Evita que los scripts shell se rompan en Linux (OCI) por saltos de línea CRLF.
# =============================================================================

# Scripts shell (ejecutados en Linux / contenedores): SIEMPRE LF
*.sh text eol=lf

# Scripts de PowerShell / Batch (ejecutados en Windows): CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf

# Archivos de entorno: normalizados
*.env text
*.env.example text

# Binarios y archivos que nunca deben normalizarse
*.exe binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.xlsx binary
*.docx binary
*.zip binary