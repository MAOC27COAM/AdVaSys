' ========================================================================
' DIAGRAMA DE ACTIVIDAD: MATRICULAR NUEVO ESTUDIANTE
' ========================================================================
@startuml Matricular Nuevo Estudiante
start
:Admin/Matriculador selecciona ciclo activo;
:Sistema verifica ciclo en periodo operable;
if (Ciclo válido?) then (Sí)
  :Usuario hace clic en "Nuevo Estudiante";
  :Sistema muestra formulario\n(datos personales, académicos, apoderado);
  :Usuario ingresa datos;
  :Sistema valida DNI de 8 dígitos;
  if (DNI ya existe como User?) then (Sí)
    :Sistema recupera User existente;
    if (Ya matriculado en este ciclo?) then (Sí)
      :Mostrar error: "Estudiante ya matriculado";
      stop
    else (No)
      :Sistema crea CycleEnrollment;
    endif
  else (No)
    :Sistema crea User + StudentProfile;
    :Sistema crea CycleEnrollment;
  endif
  if (Se registró pago inicial?) then (Sí)
    :Sistema crea PaymentAgreement\n+ PaymentTransaction;
  else (No)
    :Sistema crea PaymentAgreement\nsin pago inicial;
  endif
  :Estudiante matriculado exitosamente;
else (No)
  :Mostrar error: "Ciclo fuera de periodo";
endif
stop
@enduml



' ========================================================================
' DIAGRAMA DE ACTIVIDAD: INICIAR Y CERRAR SESIÓN DE ASISTENCIA
' ========================================================================
@startuml Sesion de Asistencia
start
:Admin/Matriculador selecciona\n"Nueva sesión de asistencia";
:Sistema crea AttendanceSession\ncon hora de inicio;
:Sistema carga lista de estudiantes\ndel ciclo activo;
while (Sesión en curso)
  :Usuario escanea QR\no registra manualmente;
  :Sistema registra AttendanceRecord\ncon estado PRESENT;
  if (Es tardanza?) then (Sí)
    :Usuario cambia estado a LATE;
  endif
  :Reproducir sonido de éxito;
endwhile (Finalizar sesión)
:Sistema marca no registrados\ncomo ABSENT;
:Sesión cerrada exitosamente;
stop
@enduml



' ========================================================================
' DIAGRAMA DE ACTIVIDAD: PROCESAR SIMULACRO
' ========================================================================
@startuml Procesar Simulacro
start
:Admin/Matriculador crea\nevento de simulacro;
:Define: nombre, N° preguntas,\nmodalidades, separación temática;
:Sube archivo Excel con\nrespuestas de estudiantes;
:Sistema valida códigos\ncontra base de datos;
:Usuario ingresa\nclave de respuestas;
:Usuario confirma procesamiento;
repeat
  :Sistema lee fila del Excel;
  :Obtiene respuestas del estudiante;
  :Compara con clave de respuestas;
  if (Respuesta correcta?) then (Sí)
    :+4 puntos;
  else (No)
    :-1 punto;
  endif
  :Acumula puntaje por segmento temático;
repeat while (Más filas?) is (Sí)
->No;
:Sistema calcula ranking\npor puntaje total descendente;
:Sistema guarda resultados\nen base de datos;
:Usuario visualiza resultados\nen tabla dinámica;
:Usuario descarga Excel\ncon resultados exportados;
stop
@enduml



' ========================================================================
' DIAGRAMA DE ACTIVIDAD: REGISTRAR PAGO
' ========================================================================
@startuml Registrar Pago
start
:Admin/Matriculador busca\nestudiante por DNI;
:Sistema muestra resumen financiero:\ntotal, inicial, saldo, cuotas;
:Usuario selecciona\n"Registrar pago";
:Usuario ingresa monto\ny número de recibo;
:Sistema autocompleta\nrecibo a 8 dígitos;
if (Monto válido?) then (No)
  :Mostrar error de validación;
  stop
else (Sí)
  :Sistema registra PaymentTransaction;
  :Sistema actualiza\ncurrentPendingAmount;
  :Sistema actualiza cuotas\nPENDING → PAID según monto;
  :Mostrar comprobante de pago;
endif
stop
@enduml
