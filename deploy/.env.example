COMPOSE_PROJECT_NAME=intranet_vallejo_beta
APP_PORT=8080

POSTGRES_DB=intranet_db
POSTGRES_USER=intranet
POSTGRES_PASSWORD=cambiar_esta_clave

JWT_SECRET=cambiar_este_secreto_largo
JWT_EXPIRES_IN=4h

# Ejemplo:
# CORS_ORIGINS=http://localhost:8080,http://192.168.18.149:8080,https://gestion.academia.com
CORS_ORIGINS=

# =============================================================================
# RUNTIME_DIR - Carpeta donde se guardan datos persistentes (BD, uploads, tmp,
# backups). El docker-compose sustituye esta variable en los volúmenes.
#
#   - Local (Windows):   ./runtime  (por defecto, no es necesario definirlo)
#   - VM OCI (Linux):    /data/runtime  (volumen de bloque montado en /data)
# =============================================================================
#RUNTIME_DIR=./runtime