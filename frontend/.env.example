# =============================================================================
# FRONTEND - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# =============================================================================
# Copia este archivo como frontend/.env para desarrollo local.
# Para producción la URL se inyecta en el build con REACT_APP_API_URL.
# NUNCA subas frontend/.env a git (ya está excluido en .gitignore).
# =============================================================================

# URL base de la API.
# En el despliegue Docker (nginx) se usa "/api" (mismo origen).
REACT_APP_API_URL=/api

# Opciones SOLO para desarrollo local:
# HOST=0.0.0.0
# DANGEROUSLY_DISABLE_HOST_CHECK=true