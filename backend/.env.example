# =============================================================================
# BACKEND - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# =============================================================================
# Copia este archivo como backend/.env y completa los valores reales.
# NUNCA subas backend/.env a git (ya está excluido en .gitignore).
# =============================================================================

# Cadena de conexión a PostgreSQL.
# Ejemplo local:   postgresql://intranet:intranet_pass@localhost:5432/intranet_db
# Ejemplo OCI VM:  postgresql://intranet:<POSTGRES_PASSWORD>@db:5432/intranet_db
DATABASE_URL="postgresql://intranet:cambiar_clave@localhost:5432/intranet_db"

# Secreto JWT (generar uno largo: openssl rand -hex 64)
JWT_SECRET="cambiar_este_secreto_largo"

# Vigencia del token JWT
JWT_EXPIRES_IN="4h"

# Puertos del servidor
PORT=4000
HOST="0.0.0.0"

# Orígenes permitidos por CORS (separados por coma).
# Ejemplo: CORS_ORIGINS=http://localhost:8080,http://IP_OCI:8080
CORS_ORIGINS=""

# =============================================================================
# CONTRASEÑAS DEL SEED (opcional, SOLO para producción)
# =============================================================================
# Si no se definen, el seed usa contraseñas por defecto y lo advierte en consola.
# En producción defínelas y cámbialas inmediatamente tras el primer login.
#SEED_PASSWORD_KAMI=""
#SEED_PASSWORD_ADMIN=""
#SEED_PASSWORD_MATRICULADOR=""